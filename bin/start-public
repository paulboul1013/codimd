#!/usr/bin/env python3
"""Publish the local CodiMD through a Cloudflare quick tunnel and a GitHub Pages redirect.

GitHub Pages serves static files only, so it cannot run CodiMD. This script runs a
public CodiMD container next to the local database, exposes it with a Cloudflare
quick tunnel, and publishes the tunnel URL to the gh-pages branch. The Pages site
redirects visitors to the current tunnel. A quick tunnel gets a new URL on every
start, so rerun this script after a restart; it republishes the redirect.
"""
import argparse
import json
import re
import subprocess
import sys
import tempfile
import time
from importlib.machinery import SourceFileLoader
from pathlib import Path
from urllib.request import Request, urlopen

ROOT = Path(__file__).resolve().parents[1]
local = SourceFileLoader('start_local', str(ROOT / 'bin/start-local')).load_module()

APP = 'codimd-public-app-1'
TUNNEL = 'codimd-public-tunnel'
TUNNEL_IMAGE = 'cloudflare/cloudflared:2025.8.1'
BRANCH = 'gh-pages'
# Anonymous visitors cannot create or edit notes, and strangers cannot register.
PUBLIC_ENV = {
  'CMD_PROTOCOL_USESSL': 'true',
  'CMD_URL_ADDPORT': 'false',
  'CMD_ALLOW_ANONYMOUS': 'false',
  'CMD_ALLOW_ANONYMOUS_EDITS': 'false',
  'CMD_ALLOW_EMAIL_REGISTER': 'false',
}

REDIRECT_PAGE = '''<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>CodiMD</title>
<style>body{font-family:system-ui,sans-serif;margin:3rem 1rem;text-align:center;color:#333}</style>
</head>
<body>
<p id="status">正在連線到 CodiMD…</p>
<script>
// Keep the path after the repository segment: /codimd/abc -> <tunnel>/abc
var rest = location.pathname.split('/').slice(2).join('/') + location.search + location.hash
fetch('target.json?t=' + Date.now(), { cache: 'no-store' })
  .then(function (r) { return r.json() })
  .then(function (t) { location.replace(t.url + '/' + rest) })
  .catch(function () {
    document.getElementById('status').textContent = 'CodiMD 目前未上線。'
  })
</script>
</body>
</html>
'''


def run(*args, **kwargs):
  print('+ ' + ' '.join(args), flush=True)
  return subprocess.run(args, cwd=ROOT, check=True, text=True, **kwargs)


def output(*args):
  return subprocess.check_output(args, cwd=ROOT, text=True).strip()


def remove(name):
  subprocess.run(['docker', 'rm', '-f', name], cwd=ROOT, capture_output=True)


def start_tunnel():
  remove(TUNNEL)
  run('docker', 'run', '-d', '--name', TUNNEL, '--network', local.NETWORK, TUNNEL_IMAGE,
      'tunnel', '--no-autoupdate', '--url', f'http://{APP}:3000')
  deadline = time.monotonic() + 60
  while time.monotonic() < deadline:
    logs = subprocess.run(['docker', 'logs', TUNNEL], capture_output=True, text=True)
    match = re.search(r'https://[a-z0-9-]+\.trycloudflare\.com', logs.stdout + logs.stderr)
    if match:
      return match.group(0)
    time.sleep(1)
  raise RuntimeError(f'No tunnel URL after 60 seconds. Check: docker logs {TUNNEL}')


def start_app(url):
  app = local.inspect(local.APP)
  config = app['Config']
  env = dict(item.split('=', 1) for item in config['Env'])
  env.update(PUBLIC_ENV, CMD_DOMAIN=url.removeprefix('https://'))
  remove(APP)
  # Two realtime servers on one database would overwrite each other's edits.
  if app['State']['Running']:
    run('docker', 'stop', local.APP)
  command = ['docker', 'run', '-d', '--name', APP, '--network', local.NETWORK,
             '--volumes-from', local.APP, '--workdir', config['WorkingDir']]
  if config['User']:
    command.extend(['--user', config['User']])
  for key, value in env.items():
    if key != 'PATH':
      command.extend(['--env', f'{key}={value}'])
  run(*command, '--entrypoint', config['Entrypoint'][0], config['Image'], *config['Cmd'])


def wait_for_public(url):
  deadline = time.monotonic() + 180
  while True:
    try:
      return local.check_service(url + '/')
    except RuntimeError as error:
      if time.monotonic() > deadline:
        raise RuntimeError(f'{url} is not serving CodiMD: {error}. Check: docker logs {APP}')
      time.sleep(3)


def publish_pages(url):
  """Commit the redirect site to gh-pages without touching the working tree."""
  repo = output('gh', 'repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner')
  owner, name = repo.split('/')
  pages_url = f'https://{owner.lower()}.github.io/{name}/'
  files = {
    'index.html': REDIRECT_PAGE,
    '404.html': REDIRECT_PAGE,
    '.nojekyll': '',
    'target.json': json.dumps({'url': url}) + '\n',
  }
  with tempfile.TemporaryDirectory() as tmp:
    entries = []
    for filename, content in files.items():
      path = Path(tmp, filename)
      path.write_text(content, encoding='utf-8')
      entries.append(f'100644 blob {output("git", "hash-object", "-w", str(path))}\t{filename}')
    tree = subprocess.run(['git', 'mktree'], cwd=ROOT, input='\n'.join(entries) + '\n',
                          capture_output=True, text=True, check=True).stdout.strip()
  subprocess.run(['git', 'fetch', '-q', 'origin', BRANCH], cwd=ROOT, capture_output=True)
  parent = subprocess.run(['git', 'rev-parse', '-q', '--verify', f'refs/remotes/origin/{BRANCH}'],
                          cwd=ROOT, capture_output=True, text=True).stdout.strip()
  commit = output('git', 'commit-tree', tree, *(['-p', parent] if parent else []),
                  '-m', f'chore: point CodiMD redirect to {url}')
  run('git', 'push', 'origin', f'{commit}:refs/heads/{BRANCH}')

  if subprocess.run(['gh', 'api', f'repos/{repo}/pages'], capture_output=True).returncode:
    run('gh', 'api', '-X', 'POST', f'repos/{repo}/pages', '-f', f'source[branch]={BRANCH}',
        '-f', 'source[path]=/', capture_output=True)
  run('gh', 'repo', 'edit', repo, '--homepage', pages_url)
  return pages_url


def wait_for_pages(pages_url, url):
  deadline = time.monotonic() + 300
  while time.monotonic() < deadline:
    try:
      request = Request(f'{pages_url}target.json?t={time.time()}', headers={'Cache-Control': 'no-cache'})
      with urlopen(request, timeout=10) as response:
        if json.load(response).get('url') == url:
          return
    except (OSError, ValueError):
      pass
    time.sleep(5)
  raise RuntimeError(f'{pages_url} did not publish {url} within 5 minutes.')


def stop():
  remove(TUNNEL)
  remove(APP)
  run('docker', 'start', local.APP)


def main():
  parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
  parser.add_argument('--stop', action='store_true', help='remove the public containers and restart the local service')
  args = parser.parse_args()
  try:
    if args.stop:
      stop()
      print(f'Stopped. Run ./bin/start-local to verify {local.URL}')
      return 0
    url = start_tunnel()
    start_app(url)
    count = wait_for_public(url)
    pages_url = publish_pages(url)
    wait_for_pages(pages_url, url)
  except (RuntimeError, subprocess.CalledProcessError) as error:
    print(f'ERROR: {error}', file=sys.stderr)
    return 1
  print(f'Tunnel: {url} ({count} CSS/JavaScript assets verified)')
  print(f'GitHub Pages: {pages_url}')
  return 0


if __name__ == '__main__':
  sys.exit(main())
